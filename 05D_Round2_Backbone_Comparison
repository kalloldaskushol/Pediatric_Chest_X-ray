{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.x"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"kernelVersion","sourceId":341777608},{"sourceType":"kernelVersion","sourceId":341784546},{"sourceType":"kernelVersion","sourceId":341966275}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# 05D — Round-2 Backbone Comparison and Final Backbone Freeze\n\n**Project:** Pedi-CGAM Lite  \n**Stage:** Final backbone selection after 320×320 Round-2 training  \n**Models compared:** ResNet50, DenseNet121, EfficientNet-B0\n\nThis notebook performs **no training**.\n\nIt loads the saved outputs from the three Round-2 notebooks, verifies that they used the exact same frozen Stage 02 split and controlled protocol, compares their validation results, and freezes the final backbone for the next long-tail loss experiments.\n\n## Required Kaggle inputs\n\nAttach the saved outputs of:\n\n- `05A_Round2_ResNet50_320`\n- `05B_Round2_DenseNet121_320`\n- `05C_Round2_EfficientNetB0_320`\n\nYou do **not** need VinDr-PCXR or Stage 02 for this comparison notebook.\n\n## Frozen selection rule\n\nThe final backbone is selected primarily by:\n\n**14-pathology validation Macro-AUPRC**\n\nSecondary evidence:\n\n- Tail Macro-AUPRC\n- 14-pathology Macro-AUROC\n- Head / Middle / Tail behavior\n- fixed-threshold F1 / sensitivity\n- training time and GPU memory\n\nBecause some tail validation classes contain only one or a few positive samples, tail metrics are treated as important but **not stable enough to override a clear primary-metric winner**.\n\n## Expected output ZIP\n\n`/kaggle/working/PediCGAM_Stage05D_Round2_Backbone_Comparison_All_Outputs.zip`\n","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# 1. Imports and constants\n# ============================================================\nimport json\nimport shutil\nimport zipfile\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nKAGGLE_INPUT = Path(\"/kaggle/input\")\n\nOUTPUT_DIR = Path(\n    \"/kaggle/working/PediCGAM/stage05d_round2_backbone_comparison\"\n)\nTABLE_DIR = OUTPUT_DIR / \"tables\"\nFIG_DIR = OUTPUT_DIR / \"figures\"\n\nfor d in [OUTPUT_DIR, TABLE_DIR, FIG_DIR]:\n    d.mkdir(parents=True, exist_ok=True)\n\nEXPECTED_EXPERIMENTS = {\n    \"R2A_ResNet50_320\": \"ResNet50\",\n    \"R2B_DenseNet121_320\": \"DenseNet121\",\n    \"R2C_EfficientNetB0_320\": \"EfficientNet-B0\",\n}\n\nEXPECTED_SPLIT_SHA256 = (\n    \"3d2f8de854c9f61382b1ef5594264af739fcb1d3d9ca8ca9fe8d388380363770\"\n)\n\nEXPECTED_PROTOCOL = {\n    \"image_size\": 320,\n    \"loss\": \"BCEWithLogitsLoss\",\n    \"optimizer\": \"AdamW\",\n    \"learning_rate\": 1e-4,\n    \"weight_decay\": 1e-4,\n    \"batch_size\": 8,\n    \"max_epochs\": 25,\n    \"early_stopping_patience\": 5,\n    \"seed\": 42,\n    \"selection_metric\": \"validation_pathology14_macro_AUPRC\",\n    \"train_images\": 5408,\n    \"validation_images\": 1159,\n    \"calibration_used\": False,\n    \"official_test_used\": False,\n}\n\nprint(\"Expected Round-2 experiments:\")\nfor exp_id, backbone in EXPECTED_EXPERIMENTS.items():\n    print(f\"- {exp_id}: {backbone}\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 2. Extract attached ZIP outputs if present\n# ============================================================\nEXTRACT_ROOT = Path(\"/kaggle/working/stage05d_extracted_inputs\")\nEXTRACT_ROOT.mkdir(parents=True, exist_ok=True)\n\nextracted = []\n\nfor zp in KAGGLE_INPUT.rglob(\"*.zip\"):\n    name_lower = zp.name.lower()\n\n    # Only inspect ZIPs that look related to the three Round-2 runs.\n    if not any(exp.lower() in name_lower for exp in EXPECTED_EXPERIMENTS):\n        continue\n\n    target = EXTRACT_ROOT / zp.stem\n\n    if not target.exists():\n        target.mkdir(parents=True, exist_ok=True)\n\n        try:\n            with zipfile.ZipFile(zp, \"r\") as zf:\n                zf.extractall(target)\n            extracted.append(str(zp))\n            print(\"Extracted:\", zp)\n        except zipfile.BadZipFile:\n            print(\"Skipped invalid ZIP:\", zp)\n\nprint(\"\\nRound-2 ZIPs extracted:\", len(extracted))\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 3. Discover all three experiment output directories\n# ============================================================\nSEARCH_ROOTS = [KAGGLE_INPUT, EXTRACT_ROOT]\n\ndiscovered = {}\n\nfor root in SEARCH_ROOTS:\n    for config_path in root.rglob(\"config.json\"):\n        try:\n            cfg = json.loads(config_path.read_text())\n        except Exception:\n            continue\n\n        exp_id = cfg.get(\"experiment_id\")\n\n        if exp_id in EXPECTED_EXPERIMENTS and exp_id not in discovered:\n            discovered[exp_id] = {\n                \"root\": config_path.parent,\n                \"config_path\": config_path,\n                \"config\": cfg,\n            }\n\nfor exp_id in EXPECTED_EXPERIMENTS:\n    if exp_id in discovered:\n        print(\"✅\", exp_id, \"->\", discovered[exp_id][\"root\"])\n    else:\n        print(\"❌\", exp_id)\n\nmissing = [\n    exp_id\n    for exp_id in EXPECTED_EXPERIMENTS\n    if exp_id not in discovered\n]\n\nif missing:\n    raise FileNotFoundError(\n        \"Missing Round-2 outputs: \"\n        + \", \".join(missing)\n        + \". Attach the saved outputs of 05A, 05B, and 05C.\"\n    )\n\nprint(\"\\n✅ All three Round-2 experiments discovered.\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 4. Fair-comparison integrity gate\n# ============================================================\nverification_rows = []\n\nfor exp_id, info in discovered.items():\n    cfg = info[\"config\"]\n\n    row = {\n        \"experiment_id\": exp_id,\n        \"backbone\": EXPECTED_EXPERIMENTS[exp_id],\n        \"split_sha256_ok\":\n            cfg.get(\"split_manifest_sha256\") == EXPECTED_SPLIT_SHA256,\n    }\n\n    for key, expected in EXPECTED_PROTOCOL.items():\n        actual = cfg.get(key)\n\n        if isinstance(expected, float):\n            passed = (\n                actual is not None\n                and np.isclose(float(actual), expected)\n            )\n        else:\n            passed = actual == expected\n\n        row[f\"{key}_ok\"] = bool(passed)\n\n    row[\"all_checks_pass\"] = all(\n        value\n        for key, value in row.items()\n        if key.endswith(\"_ok\") or key == \"split_sha256_ok\"\n    )\n\n    verification_rows.append(row)\n\nverification_df = (\n    pd.DataFrame(verification_rows)\n    .sort_values(\"experiment_id\")\n    .reset_index(drop=True)\n)\n\ndisplay(verification_df)\n\nverification_df.to_csv(\n    TABLE_DIR / \"round2_fairness_verification.csv\",\n    index=False,\n)\n\nif not verification_df[\"all_checks_pass\"].all():\n    raise RuntimeError(\n        \"At least one Round-2 experiment differs from the frozen \"\n        \"comparison protocol. Do not select a final backbone.\"\n    )\n\nprint(\"✅ All three Round-2 experiments pass the fairness gate.\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 5. Load summary, H/M/T, and environment metrics\n# ============================================================\ndef metric_dict(path):\n    df = pd.read_csv(path)\n\n    if not {\"metric\", \"value\"}.issubset(df.columns):\n        raise ValueError(f\"Unexpected summary metric format: {path}\")\n\n    return {\n        str(row[\"metric\"]): float(row[\"value\"])\n        for _, row in df.iterrows()\n    }\n\nrows = []\n\nfor exp_id in EXPECTED_EXPERIMENTS:\n    root = discovered[exp_id][\"root\"]\n\n    summary_path = root / \"tables\" / \"summary_metrics.csv\"\n    hmt_path = root / \"tables\" / \"head_middle_tail_metrics.csv\"\n    env_path = root / \"environment_info.json\"\n\n    for required in [summary_path, hmt_path, env_path]:\n        if not required.exists():\n            raise FileNotFoundError(required)\n\n    summary = metric_dict(summary_path)\n    hmt = pd.read_csv(hmt_path)\n    env = json.loads(env_path.read_text())\n\n    group_map = dict(\n        zip(hmt[\"group\"], hmt[\"macro_AUPRC\"])\n    )\n\n    rows.append({\n        \"experiment_id\": exp_id,\n        \"backbone\": EXPECTED_EXPERIMENTS[exp_id],\n        \"macro_AUPRC_14\":\n            summary[\"pathology14_macro_AUPRC\"],\n        \"head_macro_AUPRC\":\n            float(group_map[\"Head\"]),\n        \"middle_macro_AUPRC\":\n            float(group_map[\"Middle\"]),\n        \"tail_macro_AUPRC\":\n            float(group_map[\"Tail\"]),\n        \"macro_AUROC_14\":\n            summary[\"pathology14_macro_AUROC\"],\n        \"macro_F1_at_0.5\":\n            summary[\"pathology14_macro_F1_at_0.5\"],\n        \"macro_sensitivity_at_0.5\":\n            summary[\"pathology14_macro_sensitivity_at_0.5\"],\n        \"macro_specificity_at_0.5\":\n            summary[\"pathology14_macro_specificity_at_0.5\"],\n        \"macro_balanced_accuracy_at_0.5\":\n            summary[\"pathology14_macro_balanced_accuracy_at_0.5\"],\n        \"best_epoch\":\n            int(env[\"best_epoch\"]),\n        \"training_minutes\":\n            float(env[\"training_minutes\"]),\n        \"peak_gpu_memory_gb\":\n            float(env[\"peak_gpu_memory_gb\"]),\n    })\n\ncomparison = pd.DataFrame(rows)\n\ncomparison[\"rank_macro_AUPRC\"] = (\n    comparison[\"macro_AUPRC_14\"]\n    .rank(method=\"min\", ascending=False)\n    .astype(int)\n)\n\ncomparison[\"rank_tail_AUPRC\"] = (\n    comparison[\"tail_macro_AUPRC\"]\n    .rank(method=\"min\", ascending=False)\n    .astype(int)\n)\n\ncomparison[\"rank_macro_AUROC\"] = (\n    comparison[\"macro_AUROC_14\"]\n    .rank(method=\"min\", ascending=False)\n    .astype(int)\n)\n\ncomparison = comparison.sort_values(\n    [\"rank_macro_AUPRC\", \"rank_tail_AUPRC\"]\n).reset_index(drop=True)\n\ndisplay(comparison)\n\ncomparison.to_csv(\n    TABLE_DIR / \"round2_backbone_comparison.csv\",\n    index=False,\n)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Selection rule\n\nThe final backbone is **not** chosen by averaging unrelated ranks.\n\nThe project already defined **14-pathology Macro-AUPRC as the primary model-selection metric**. Therefore:\n\n- if one model clearly leads Macro-AUPRC, it is selected;\n- tail AUPRC and AUROC are reported as important complementary evidence;\n- a stronger tail metric alone does not overturn a clear primary-metric winner because the rarest validation labels have very few positives.\n","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# 6. Freeze final backbone\n# ============================================================\nwinner = (\n    comparison\n    .sort_values(\"macro_AUPRC_14\", ascending=False)\n    .iloc[0]\n)\n\nrunner_up = (\n    comparison\n    .sort_values(\"macro_AUPRC_14\", ascending=False)\n    .iloc[1]\n)\n\nbest_tail = (\n    comparison\n    .sort_values(\"tail_macro_AUPRC\", ascending=False)\n    .iloc[0]\n)\n\nbest_auroc = (\n    comparison\n    .sort_values(\"macro_AUROC_14\", ascending=False)\n    .iloc[0]\n)\n\nabsolute_margin = (\n    winner[\"macro_AUPRC_14\"]\n    - runner_up[\"macro_AUPRC_14\"]\n)\n\nrelative_margin = (\n    absolute_margin\n    / runner_up[\"macro_AUPRC_14\"]\n)\n\nFINAL_BACKBONE = winner[\"backbone\"]\nFINAL_EXPERIMENT_ID = winner[\"experiment_id\"]\n\nselection_summary = pd.DataFrame([{\n    \"final_backbone\": FINAL_BACKBONE,\n    \"source_experiment_id\": FINAL_EXPERIMENT_ID,\n    \"primary_metric\": \"14-pathology Macro-AUPRC\",\n    \"winner_macro_AUPRC\": winner[\"macro_AUPRC_14\"],\n    \"runner_up_backbone\": runner_up[\"backbone\"],\n    \"runner_up_macro_AUPRC\": runner_up[\"macro_AUPRC_14\"],\n    \"absolute_macro_AUPRC_margin\": absolute_margin,\n    \"relative_margin_vs_runner_up\": relative_margin,\n    \"best_tail_backbone\": best_tail[\"backbone\"],\n    \"best_tail_macro_AUPRC\": best_tail[\"tail_macro_AUPRC\"],\n    \"best_macro_AUROC_backbone\": best_auroc[\"backbone\"],\n    \"best_macro_AUROC\": best_auroc[\"macro_AUROC_14\"],\n}])\n\ndisplay(selection_summary)\n\nselection_summary.to_csv(\n    TABLE_DIR / \"final_backbone_selection.csv\",\n    index=False,\n)\n\nfreeze = {\n    \"final_backbone\": FINAL_BACKBONE,\n    \"source_experiment_id\": FINAL_EXPERIMENT_ID,\n    \"resolution\": 320,\n    \"primary_selection_metric\":\n        \"validation_pathology14_macro_AUPRC\",\n    \"selection_rule\":\n        \"Highest 14-pathology validation Macro-AUPRC; \"\n        \"tail AUPRC and Macro-AUROC retained as secondary evidence.\",\n    \"split_manifest_sha256\": EXPECTED_SPLIT_SHA256,\n    \"seed_used_for_backbone_screening\": 42,\n    \"calibration_used\": False,\n    \"official_test_used\": False,\n}\n\n(\n    OUTPUT_DIR / \"FINAL_BACKBONE_FREEZE.json\"\n).write_text(json.dumps(freeze, indent=2))\n\nprint(\"=\" * 70)\nprint(\"FINAL BACKBONE:\", FINAL_BACKBONE)\nprint(\"Source experiment:\", FINAL_EXPERIMENT_ID)\nprint(\n    \"Macro-AUPRC:\",\n    f\"{winner['macro_AUPRC_14']:.6f}\"\n)\nprint(\n    \"Margin vs runner-up:\",\n    f\"{absolute_margin:.6f}\",\n    f\"({relative_margin*100:.1f}% relative)\"\n)\nprint(\"=\" * 70)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 7. Comparison figures\n# ============================================================\ndef save_bar(metric, xlabel, title, filename):\n    plot_df = comparison.sort_values(metric, ascending=True)\n\n    fig, ax = plt.subplots(figsize=(8, 4.8))\n    ax.barh(plot_df[\"backbone\"], plot_df[metric])\n    ax.set_xlabel(xlabel)\n    ax.set_title(title)\n    ax.grid(axis=\"x\", alpha=0.25)\n\n    plt.tight_layout()\n    plt.savefig(\n        FIG_DIR / filename,\n        dpi=220,\n        bbox_inches=\"tight\",\n    )\n    plt.show()\n\nsave_bar(\n    \"macro_AUPRC_14\",\n    \"14-pathology Macro-AUPRC\",\n    \"Round-2 Backbone Comparison — Primary Metric\",\n    \"round2_macro_auprc.png\",\n)\n\nsave_bar(\n    \"tail_macro_AUPRC\",\n    \"Tail Macro-AUPRC\",\n    \"Round-2 Backbone Comparison — Tail Performance\",\n    \"round2_tail_auprc.png\",\n)\n\nsave_bar(\n    \"macro_AUROC_14\",\n    \"14-pathology Macro-AUROC\",\n    \"Round-2 Backbone Comparison — Macro-AUROC\",\n    \"round2_macro_auroc.png\",\n)\n\nsave_bar(\n    \"training_minutes\",\n    \"Training time (minutes)\",\n    \"Round-2 Backbone Comparison — Training Time\",\n    \"round2_training_time.png\",\n)\n\nsave_bar(\n    \"peak_gpu_memory_gb\",\n    \"Peak GPU memory (GB)\",\n    \"Round-2 Backbone Comparison — GPU Memory\",\n    \"round2_gpu_memory.png\",\n)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 8. Head / Middle / Tail grouped table and figure\n# ============================================================\ngroup_table = comparison[\n    [\n        \"backbone\",\n        \"head_macro_AUPRC\",\n        \"middle_macro_AUPRC\",\n        \"tail_macro_AUPRC\",\n    ]\n].copy()\n\ndisplay(group_table)\n\ngroup_table.to_csv(\n    TABLE_DIR / \"round2_head_middle_tail_comparison.csv\",\n    index=False,\n)\n\nplot_df = group_table.set_index(\"backbone\")\n\nfig, ax = plt.subplots(figsize=(9, 5))\nplot_df.plot(kind=\"bar\", ax=ax)\nax.set_ylabel(\"Macro-AUPRC\")\nax.set_xlabel(\"\")\nax.set_title(\"Round-2 Head / Middle / Tail AUPRC\")\nax.tick_params(axis=\"x\", rotation=0)\nax.grid(axis=\"y\", alpha=0.25)\n\nplt.tight_layout()\nplt.savefig(\n    FIG_DIR / \"round2_hmt_group_comparison.png\",\n    dpi=220,\n    bbox_inches=\"tight\",\n)\nplt.show()\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 9. Research interpretation summary\n# ============================================================\nwinner = comparison.sort_values(\n    \"macro_AUPRC_14\", ascending=False\n).iloc[0]\n\nrunner_up = comparison.sort_values(\n    \"macro_AUPRC_14\", ascending=False\n).iloc[1]\n\nbest_tail = comparison.sort_values(\n    \"tail_macro_AUPRC\", ascending=False\n).iloc[0]\n\nbest_auroc = comparison.sort_values(\n    \"macro_AUROC_14\", ascending=False\n).iloc[0]\n\nsummary_lines = [\n    \"Pedi-CGAM Lite — Stage 05D Round-2 Backbone Comparison\",\n    \"=\" * 70,\n    \"\",\n    \"FAIRNESS\",\n    \"- All three finalists used the same frozen Stage 02 split.\",\n    \"- All used 320x320 inputs, BCEWithLogitsLoss, AdamW, seed 42.\",\n    \"- Batch size = 8; max epochs = 25; early stopping patience = 5.\",\n    \"- Calibration split was not used.\",\n    \"- Official test was not used.\",\n    \"\",\n    \"PRIMARY RESULT\",\n    (\n        f\"- Final backbone: {winner['backbone']}\"\n    ),\n    (\n        f\"- 14-pathology Macro-AUPRC: \"\n        f\"{winner['macro_AUPRC_14']:.6f}\"\n    ),\n    (\n        f\"- Runner-up by primary metric: \"\n        f\"{runner_up['backbone']} \"\n        f\"({runner_up['macro_AUPRC_14']:.6f})\"\n    ),\n    (\n        f\"- Absolute Macro-AUPRC margin: \"\n        f\"{winner['macro_AUPRC_14'] - runner_up['macro_AUPRC_14']:.6f}\"\n    ),\n    \"\",\n    \"SECONDARY EVIDENCE\",\n    (\n        f\"- Best Tail Macro-AUPRC: \"\n        f\"{best_tail['backbone']} \"\n        f\"({best_tail['tail_macro_AUPRC']:.6f})\"\n    ),\n    (\n        f\"- Best Macro-AUROC: \"\n        f\"{best_auroc['backbone']} \"\n        f\"({best_auroc['macro_AUROC_14']:.6f})\"\n    ),\n    \"\",\n    \"INTERPRETATION\",\n    (\n        \"- The final backbone is frozen using the pre-declared \"\n        \"primary metric, 14-pathology validation Macro-AUPRC.\"\n    ),\n    (\n        \"- Tail AUPRC remains scientifically important, but the \"\n        \"ultra-rare validation labels make this estimate unstable.\"\n    ),\n    (\n        \"- The next experiments should keep this backbone and \"\n        \"compare long-tail loss functions rather than continue \"\n        \"backbone searching.\"\n    ),\n    \"\",\n    \"NEXT STAGE\",\n    \"- BCE\",\n    \"- Weighted BCE\",\n    \"- Focal Loss\",\n    \"- Asymmetric Loss (ASL)\",\n    \"\",\n    \"The official test remains sealed.\",\n]\n\nsummary_text = \"\\n\".join(summary_lines)\n\nprint(summary_text)\n\n(\n    OUTPUT_DIR / \"README_STAGE05D_RESULTS.txt\"\n).write_text(summary_text)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 10. Final integrity gate\n# ============================================================\nchecks = pd.DataFrame([\n    {\n        \"check\": \"All 3 Round-2 experiments discovered\",\n        \"passed\": len(discovered) == 3,\n    },\n    {\n        \"check\": \"All protocol/fairness checks passed\",\n        \"passed\": verification_df[\"all_checks_pass\"].all(),\n    },\n    {\n        \"check\": \"Primary metrics are finite\",\n        \"passed\": np.isfinite(\n            comparison[\"macro_AUPRC_14\"]\n        ).all(),\n    },\n    {\n        \"check\": \"Tail metrics are finite\",\n        \"passed\": np.isfinite(\n            comparison[\"tail_macro_AUPRC\"]\n        ).all(),\n    },\n    {\n        \"check\": \"Exactly one final backbone frozen\",\n        \"passed\": isinstance(FINAL_BACKBONE, str)\n            and len(FINAL_BACKBONE) > 0,\n    },\n    {\n        \"check\": \"Calibration remained unused\",\n        \"passed\": all(\n            info[\"config\"].get(\"calibration_used\") is False\n            for info in discovered.values()\n        ),\n    },\n    {\n        \"check\": \"Official test remained sealed\",\n        \"passed\": all(\n            info[\"config\"].get(\"official_test_used\") is False\n            for info in discovered.values()\n        ),\n    },\n])\n\nchecks[\"status\"] = checks[\"passed\"].map(\n    {True: \"PASS\", False: \"REVIEW\"}\n)\n\ndisplay(checks)\n\nchecks.to_csv(\n    OUTPUT_DIR / \"stage05d_final_status.csv\",\n    index=False,\n)\n\nFINAL_STATUS = (\n    \"PASS\"\n    if checks[\"passed\"].all()\n    else \"REVIEW\"\n)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"STAGE 05D FINAL STATUS:\", FINAL_STATUS)\n\nif FINAL_STATUS == \"PASS\":\n    print(\"✅ ROUND-2 BACKBONE COMPARISON COMPLETE\")\n    print(\"🔒 FINAL BACKBONE FROZEN:\", FINAL_BACKBONE)\nelse:\n    print(\"⚠️ REVIEW BEFORE STARTING LOSS EXPERIMENTS\")\n\nprint(\"=\" * 70)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# 11. ZIP all Stage 05D outputs\n# ============================================================\nZIP_BASE = Path(\n    \"/kaggle/working/\"\n    \"PediCGAM_Stage05D_Round2_Backbone_Comparison_All_Outputs\"\n)\n\nZIP_FILE = Path(str(ZIP_BASE) + \".zip\")\n\nif ZIP_FILE.exists():\n    ZIP_FILE.unlink()\n\nshutil.make_archive(\n    base_name=str(ZIP_BASE),\n    format=\"zip\",\n    root_dir=str(OUTPUT_DIR),\n)\n\nprint(\"✅ STAGE 05D ZIP CREATED\")\nprint(\"File:\", ZIP_FILE)\nprint(\n    f\"Size: {ZIP_FILE.stat().st_size/(1024**2):.2f} MB\"\n)\nprint(\"\\nDownload this one ZIP from Kaggle Output.\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## After Stage 05D passes\n\nFreeze the selected backbone. Do not search more architectures.\n\nThe next controlled experiment family will compare long-tail loss functions on the frozen 320×320 backbone:\n\n- `06A_FinalBackbone_BCE.ipynb`\n- `06B_FinalBackbone_WeightedBCE.ipynb`\n- `06C_FinalBackbone_FocalLoss.ipynb`\n- `06D_FinalBackbone_AsymmetricLoss.ipynb`\n- `07_LongTail_Loss_Comparison.ipynb`\n\nOnly after the loss study should we add finding supervision, box guidance, and CGAM.\n","metadata":{}}]}